# Copy to .env for local work. In production (Render) set these in the dashboard instead; see render.yaml.
PORT=4000
# Marks a production deploy: the server then refuses to start if a required variable below is missing.
# Leave it unset locally.
# NODE_ENV=production

# The website's address(es), comma separated, no trailing slash. Production: https://your-site.vercel.app,https://www.yourdomain.com
CORS_ORIGIN=http://localhost:3000
# Only used by "npm run import:local" to read the old JSON files
DATA_DIR=data
# Admin panel login (used once, to create the account on first start; change it later in Admin > Settings)
ADMIN_EMAIL=admin@kripty.studio
ADMIN_PASSWORD=change-me-to-a-long-password
# Signs admin sessions (required in production). Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Cloudinary: where admin-uploaded images and videos are stored (required in production).
# Copy "API environment variable" from Cloudinary > Settings > API Keys (cloudinary://API_KEY:API_SECRET@CLOUD_NAME).
# Or set the three CLOUDINARY_CLOUD_NAME / CLOUDINARY_API_KEY / CLOUDINARY_API_SECRET variables instead.
# Left empty, uploads are saved to the local UPLOADS_DIR folder (development only).
CLOUDINARY_URL=
# Folder inside Cloudinary for this site's files (optional)
CLOUDINARY_FOLDER=kripty-studio
# Local fallback folder for uploads, and the folder of old files for "npm run migrate:cloudinary"
UPLOADS_DIR=uploads
# Only needed for files saved on the server's own disk before Cloudinary (/uploads/...): this API's public address
PUBLIC_API_URL=http://localhost:4000
# Website address, and the secret shared with the website so content edits show up instantly.
# REVALIDATE_SECRET must be identical here and in the frontend's environment.
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=
# Visitor analytics
# Number of proxies in front of the API so the real visitor IP is used. On Render use 1.
TRUST_PROXY=
# Store full visitor IPs (default: last IPv4 octet / IPv6 tail removed)
TRACK_FULL_IP=false
# Delete visitors not seen for this many days
TRACK_RETENTION_DAYS=395

# MongoDB Atlas connection string (required)
MONGODB_URI=
MONGODB_DB=kripty
